#set enum(numbering: "1.a.i.")
4.
  +
    $
      4 sin 2 theta         & = 6 sin theta \
      8 sin theta cos theta & = 6 sin theta \
      8 cos theta & = 6 \
      theta & = arccos 3 / 4 \
       & = 41.4 degree $

  +
    $
      4 cos 2 theta + 6 cos theta &= P \
      4 cos 82.8 degree + 6 cos 41.4 degree &= P \
      P &= 5
    $
  
  +
    Horizontal component $= 3 sin 41.4 degree = 1.98$

    Vertical component $= -3 cos 41.4 degree + 5= 2.75$
    +
      $
        sqrt( (3 sin 41.4)^2 + (-3 cos 41.4 + 5)^2 ) = 3.39 "N"
      $

    +
      $
        tan theta &= (-3 cos 41.4 degree + 5)/(3 sin 41.4 degree) \
            theta &= 54.2 degree
      $

